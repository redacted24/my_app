<%= render "sidebar" %>
<div class="xl:w-[40%] mt-[5vh]">
  <div class="flex justify-between">
    <h2 class="p-0 mb-5 text-2xl font-bold"><%= @project.name %></h2>
    <%= link_to :back do %>
      <i class="fa-solid fa-arrow-left"></i><span>Back</span>
    <% end %>
  </div>
  <% if @project.github_link != "" %>
    <a href="<%= @project.github_link %>" target="_blank" class="text-gray-700">github</a>
  <% end %>
  <br>
  <br>
  <%= @project.description %>
  <div class="flex flex-wrap mt-10 mb-10">
    <% for tag in @project.tags %>
      <%= render "tag", name: tag %>
    <% end %>
  </div>
  <% if !@project.active %>
    <%= render "project/infocards/card_inactive" %>
  <% end %>
  <% if @project.in_development %>
    <%= render "project/infocards/card_development" %>
  <% end %>
  <% if @project.unreleased %>
    <%= render "project/infocards/card_unreleased" %>
  <% end %>
  <% if @project.long_description != nil %>
    <%= render "project/infocards/card_about", content: @project.long_description %>
  <% end %>
  <% if @project.preview_image != "" and @project.extra_images != nil %>
    <%= render "project/infocards/card_overview_image", project: @project %>
  <% end %>
  <% if @project.extra_images != "" and @project.extra_images != nil %>
    <% for imagelink in @project.extra_images.split(',',-1) %>
      <%= render "project/infocards/card_more_images", imagelink: imagelink %>
    <% end %>
  <% end %>
  <% if @project.github_link != "" %>
    <%= render 'project/infocards/card_links', content: @project.github_link %>
  <% else %>
    <%= render 'project/infocards/card_info', content: "This repository is private." %>
  <% end %>
  <% if @project.comments != "" %>
    <%= render "project/infocards/card_comments", content: @project.comments %>
  <% end %>
  <%= render "footer" %>
</div>
