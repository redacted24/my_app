<%= render "sidebar" %>
<div class="xl:w-[40%] mt-7 xl:mt-[5vh]">
  <div class="flex justify-between items-center mb-10 xl:mb-5">
    <h2 class="p-0 text-2xl xl:text-2xl font-bold font-baskerville"><%= @project.name %></h2>
    <div class="hidden xl:block">
      <%= link_to "/project" do %>
        <i class="fa-solid fa-arrow-left"></i><span class="font-typewriter">&nbspProjects</span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap gap-y-4 items-center justify-between mb-10">
    <div class="flex flex-wrap h-full items-center">
      <% for tag in @project.tags %>
        <%= render "tag", name: tag %>
      <% end %>
    </div>
    <% if @project.github_link != "" %>
      <a href="<%= @project.github_link %>" target="_blank" class="text-gray-700">
        <mark class="bg-amber-200 font-typewriter">
          <%= @project.github_link.split("/",4)[3] %>
        </mark>
      </a>
    <% else %>
      <div>
        <mark class="bg-amber-200 font-typewriter">Private repository.</mark>
      </div>
    <% end %>
  </div>

  <div class="border-2 border-solid p-5 bg-amber-50/50">
    <div>
      <%= @project.description.html_safe %>
    </div>
    <% if @project.long_description != '' %>
      <br>
      <%= @project.long_description.html_safe %>
    <% end %>
  </div>

  <br>
  <% if @project.preview_image != ""%>
    <div class="border-2 border-solid">
      <%= image_tag(@project.preview_image, class: "w-full") %>
    </div>
  <% end %>
  <% if @project.extra_images != "" and @project.extra_images != nil %>
    <% for imagelink in @project.extra_images.split(',') %>
      <div class="mt-5 mb-5 border-2 border-solid">
        <%= image_tag(imagelink, class: "w-full") %>
      </div>
    <% end %>
  <% end %>
  <%= render "footer" %>
</div>
