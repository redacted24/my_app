<%= render "project/sidebar" %>
<div class="xl:w-[40%] mt-7 xl:mt-[5vh]">
  <div class="mb-10 xl:mb-5 flex justify-between items-center">
    <h2 class="font-baskerville font-bold text-2xl">PROJECTS</h2>
    <div class="hidden xl:block">
      <%= link_to "/" do %>
        <i class="fa-solid fa-arrow-left"></i><span class="font-typewriter">&nbspHome</span>
      <% end %>
    </div>
  </div>
  <div class="flex flex-wrap gap-y-5 justify-between">
    <% for item in @all_projects.order(date: :desc) %>
      <%= 
        render "featured_project",
          project: item
        %>
    <% end %>
  </div>
  <%= render "footer" %>
</div>
