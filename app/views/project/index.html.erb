<%= render "project/sidebar" %>
<div class="xl:w-[40%] mt-[5vh]">
  <div class="mb-5 flex justify-between items-center">
    <h2 class="font-bold text-2xl">PROJECTS</h2>
    <%= link_to :back do %>
      <i class="fa-solid fa-arrow-left"></i>Back
    <% end %>
  </div>
  <div class="flex flex-wrap gap-y-5 justify-between">
    <% for item in @all_projects.order(date: :desc) %>
      <%= 
        render "featured_project",
          project: item
        %>
    <% end %>
  </div>
  <%= render "footer" %>
</div>
