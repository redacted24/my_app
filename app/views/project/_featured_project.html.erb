<%# locals: (project:)%>
<a href="<%= "/project/" + project.url_string %>" class=" flex w-full xl:w-[48%]">
  <div class="border border-solid transition duration-200 p-5 relative
    hover:bg-green-300">
    <div class="flex justify-between font-bold mb-5">
      <%= project.name %>
      <% if project.opensource %>
        <div class="p-3 pl-5 pr-5 bg-green-300 border border-solid 
        border-green-700 font-bold text-green-700">
          open source
        </div>
      <% else %>
        <div class="p-3 pl-5 pr-5 bg-yellow-200 border border-solid border-yellow-500
        font-bold text-yellow-500">
          closed source
        </div>
      <% end %>
    </div>
    <% if project.preview_image != "" %>
      <div class="w-full">
        <%= image_tag(project.preview_image) %>
      </div>
    <% end %>
    <div class="exp-description mb-m">
      <%= project.description %>
    </div>
    <div class="flex flex-wrap mt-3">
      <% for tag in project.tags do %>
        <div>
          <%= render "tag", name: tag%>
        </div>
      <% end %>
    </div>
  </div>
</a>
