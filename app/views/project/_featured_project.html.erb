<%# locals: (project:)%>
<a href="<%= "/project/" + project.url_string %>" class=" flex w-full xl:w-[48.5%]">
  <div class="border border-solid transition duration-200 p-5 relative
    hover:bg-gray-200">
    <div class="flex justify-between flex-wrap gap-3 font-bold mb-5">
      <%= project.name %>
      <% if project.opensource %>
        <div class="flex items-center text-xs pl-2 pr-2 bg-green-200 border border-solid 
        border-green-600 font-bold text-green-700">
          open source
        </div>
      <% else %>
        <div class="flex items-center text-xs pl-2 pr-2 bg-yellow-200 border border-solid 
        border-yellow-600 font-bold text-yellow-700">
          closed source
        </div>
      <% end %>
    </div>
    <% if project.preview_image != "" %>
      <div class="w-full">
        <%= image_tag(project.preview_image) %>
      </div>
    <% end %>
    <div class="exp-description mt-3 mb-5">
      <%= project.description %>
    </div>
    <div class="flex flex-wrap mt-3">
      <% for tag in project.tags do %>
        <div>
          <%= render "tag", name: tag%>
        </div>
      <% end %>
    </div>
  </div>
</a>
