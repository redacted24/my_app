<div class="block md:flex md:justify-center">
  <div class="md:pb-5 md:sticky md:top-0 md:max-h-screen md:max-w-[40%] md:mr-[5vw]">
    <div class="mt-[5vh]">
      <p>Hey, I'm </p>
      <h1 class="pt-5">Qiuyu Huang</h1>
      <p class="mb-5">Software Engineering Student</p>
      <div class="mt-10">
        <%= image_tag("sherma.png", width: 150) %>
      </div>
      <div class="mb-10 mt-10 text-gray-700">
        I like building things from the ground up. <br>
        <br>
        github: <a target="_blank" href="https://github.com/redacted24">@redacted24</a><br>
        email: <a target="_blank" href="mailto:huangq4@outlook.com">huangq4@outlook.com</a><br>
        photo: <a target="_blank" href="https://www.instagram.com/qiuyu__photo/">@qiuyu__photo</a>
      </div>
      <div class="socials">
        <a href="https://www.linkedin.com/in/qiuyuhuang/" target="_blank" class="muted-text no-color-a"><i class="fa-brands fa-linkedin"></i></a>
        <a href="https://github.com/redacted24" target="_blank" class="text-gray-700 "><i class="fa-brands fa-square-github"></i></a>
      </div>
    </div>
    <div class="hidden md:block">
      <div>
        <a href="#about-me">About me</a>
      </div>
      <div>
        <a href="#experience">Experience</a>
      </div>
      <div>
        <a href="#projects">Projects</a>
      </div>
    </div>
  </div>
  <div class="md:max-w-[40%] mt-[5vh]">
    <h2>ABOUT ME</h2>
    <div>
      <p>
      Just a kid trying to learn every day.<br><br>
      My interests are in low level software development, cybersecurity and game development.
      </p>
      <p>
      In my spare time, you can find me editing pictures, cooking with my dearest, practicing kendo or working on my indie game!
      </p>
      <br>
      <p>
      Checkout my arch dotfiles: <a target="_blank" href="https://github.com/redacted24/dotfiles">redacted24/dotfiles</a>
      </p>
    </div>
    <div>
      <h2>EXPERIENCE</h2>
      <%= 
        render "experience", 
        dates: "July - October 2025",
        name: "Software Developer Intern - CSBQ",
        url: "https://csbq.ca",
        description: "Cleaned legacy data and developed a procedure to mitigate 
        future users’ entry errors. Created a data processing tool reducing 
        overall time spent by more than 200%, and optimized queries and server logic to reduce page loading times by 40%.",
        tags: ["Python", "Java", "Frontend Development"]
      %>
    </div>
    <div>
      <h2>Projects</h2>
      <div class="flex flex-wrap gap-[2%]">
        <% for project in @projects.where(featured: 1).order(date: :desc) %>
          <%= 
            render "featured_project",
            dates: project.date,
            name: project.name,
            description: project.description,
            url: "/project/" + project.url_string,
            github_link: project.github_link,
            tags: project.tags,
            preview_image_link: project.preview_image,
            opensource: project.opensource
          %>
        <% end %>
      </div>
    </div>
    <a href="/project" class="font-bold">See all projects<i class="fa-solid fa-arrow-right"></i></a>
    <%= render "footer" %>
  </div>
</div>
