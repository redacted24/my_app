<a href="<%= url %>" target="_blank">
  <div class="mb-5 border border-solid 
              transition duration-100 p-5 relative border-black
              hover:bg-gray-200">
    <div class="text-disabled">
      <%= dates %>
    </div>
    <div class="font-bold mt-3">
      <%= name %>
    </div>
    <div class="text-sm mt-2">
      <%= description %>
    </div>
    <div class="flex mt-5">
      <% for tag in tags do %>
        <%= render "project/tag", name: tag %>
      <% end %>
    </div>
  </div>
</a>
