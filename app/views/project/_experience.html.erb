<a href="<%= url %>" target="_blank">
  <div class="mb-5 border border-solid 
              transition duration-100 p-10 relative border-neutral-800 
              bg-gray-800 
              hover:bg-gray-700">
    <div>
      <%= dates %>
    </div>
    <div class="flex justify-between">
      <%= name %>
    </div>
    <div class="text-sm">
    </div>
    <div class="tag-container">
      <% for tag in tags do %>
        <div class="tag">
          <%= tag %>
        </div>
      <% end %>
    </div>
  </div>
</a>
